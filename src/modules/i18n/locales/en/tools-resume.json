    "faq": {
      "title": "Questions",
      "description": "A few common questions about storage and export.",
      "items": {
        "storage": {
          "q": "Where are my resumes stored?",
          "a": "In this browser’s localStorage under toolbox.resume. A linked folder adds one JSON file per resume. Clearing browser data deletes them — keep your own backup."
        },
        "pagedExport": {
          "q": "How is Export PDF different from browser print?",
          "a": "Both PDF exports rasterise the resume, so text is not selectable. Browser print uses the system layout engine: text stays selectable and can still be saved as PDF."
        },
        "templateSwitch": {
          "q": "Does switching templates change my styling?",
          "a": "Yes. A template applies its own accent colour and section/paragraph/page spacing so the design stays intact. Re-adjust them in the left panel afterwards."
        },
        "remotePhoto": {
          "q": "Why is my linked photo missing from the export?",
          "a": "Without a backend proxy the browser cannot read pixels of a cross-origin image, so export skips it (it still displays on screen). Upload the image as a file instead."
        }
      }
    },
