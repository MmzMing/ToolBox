{
  "name": "toolbox",
  "private": false,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "ToolBox - 开发者在线工具箱（React 19 + Vite 8 + shadcn/ui）",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-codecs.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-codecs.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node scripts/check-i18n-duplicate-keys.mjs && vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "create:tool": "node scripts/create-tool.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "postbuild": "node scripts/generate-sitemap.mjs",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,mjs}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
