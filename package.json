    "figlet": "^1.11.4",
    "filesize": "^11.0.24",
    "fuse.js": "^7.5.0",
    "heic-to": "^1.5.2",
    "highlight.js": "^11.12.0",
    "html2canvas-pro": "^2.4.3",
    "http-status-codes": "^2.3.0",
    "i18next": "^26.4.2",
    "ibantools": "^4.5.4",
